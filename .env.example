# AI Markets RunPod worker. Names only: put real values in RunPod / Dokploy
# secrets, never in git.

# ---- runtime -------------------------------------------------------------
# serverless | pod | http
AIMX_RUNTIME=serverless
AIMX_VOLUME=/runpod-volume
HF_HOME=/runpod-volume/huggingface
# Only for gated repos (FLUX.1-schnell, neuphonic/neucodec). Never printed.
HF_TOKEN=
# AIMX_WORKER_ID=
# AIMX_WORKER_SANDBOX=1
# AIMX_HEAVY_CACHE=1

# ---- TTS -----------------------------------------------------------------
# Vietnamese (language vi or Vietnamese text) -> VieNeu-TTS; other languages -> Chatterbox.
# AIMX_TTS_DEFAULT_LANG=en
# AIMX_VIENEU_DEFAULT=vieneu-tts
# AIMX_VIENEU_VOICE=
# AIMX_VIENEU_CODEC=neuphonic/neucodec

# ---- Tailscale (private access to Postgres/Redis on 123HOST) ---------------
# Ephemeral + reusable + pre-approved auth key (tskey-auth-...). When set,
# scripts/entrypoint.sh joins the tailnet and forwards 127.0.0.1:5432 /
# 127.0.0.1:6379 to AIMX_TAILNET_HOST. TAILSCALE_AUTHKEY is accepted as an alias.
# Never commit the value and never bake it into the image.
#
# EXPIRY: Tailscale auth keys expire after at most 90 days. An expired key only
# stops NEW workers from joining (running workers keep their connection); the
# worker then logs "ERROR: Tailscale auth key was rejected" and starts without
# the tailnet (health job reports "tailnet": "rejected").
#
# Where it lives in production: the RunPod endpoint aimx-worker (veiasbyphk9rrd)
# template env TS_AUTHKEY={{ RUNPOD_SECRET_aimx_ts_authkey }}. To rotate, either
#   a) set TAILSCALE_AUTHKEY on the Dokploy app for ai.aimarkets.vn
#      (ai-marketplace-ai) and redeploy it; it copies the key into the RunPod
#      secret aimx_ts_authkey on startup, or
#   b) RunPod console > Secrets > aimx_ts_authkey > Edit Secret Value.
# New workers use the new key on their next boot. Full steps: README.md.
TS_AUTHKEY=
# TAILSCALE_AUTHKEY=
# AIMX_TAILNET_HOST=100.96.240.104
# AIMX_TAILNET_PORTS=5432 6379
# AIMX_TS_WAIT_SEC=90
# TS_HOSTNAME=runpod-aimx-<RUNPOD_POD_ID>

# ---- Redis queue (pod puller) ---------------------------------------------
# Same Redis and prefix as ai.aimarkets.vn. rediss:// for TLS.
# With Tailscale: redis://aimx-worker:<password>@127.0.0.1:6379/0
# AIMX_REDIS_URL wins over REDIS_URL.
AIMX_REDIS_URL=
REDIS_URL=
REDIS_KEY_PREFIX=aimarkets
# REDIS_TLS_CA_FILE=
# REDIS_TLS_INSECURE=0
# REDIS_CONNECT_TIMEOUT=5
# REDIS_SOCKET_TIMEOUT=10
# REDIS_MAX_VALUE_BYTES=1500000
# AIMX_POD_POLL_SEC=0.5
# AIMX_POD_LIGHT_SLOTS=3
# AIMX_TIMEOUT_TTS=120
# AIMX_TIMEOUT_IMAGE=180
# AIMX_TIMEOUT_VIDEO=600
# AIMX_TIMEOUT_TRAIN=3600

# ---- Postgres job log ------------------------------------------------------
# With Tailscale: postgresql://aimx_worker:<password>@127.0.0.1:5432/aimx_worker
# Order: AIMX_DATABASE_URL, AIMX_PG_DSN, DATABASE_URL.
AIMX_DATABASE_URL=
AIMX_PG_DSN=
# DATABASE_URL is used when AIMX_DATABASE_URL is empty.
DATABASE_URL=
# AIMX_DB_SSLMODE=require
# AIMX_DB_DISABLE=0
# AIMX_DB_MIGRATE=1
# AIMX_DB_CONNECT_TIMEOUT=5
# AIMX_DB_STATEMENT_TIMEOUT_MS=5000
# AIMX_DB_RETRY_SEC=30
# AIMX_DB_RESULT_MAX_BYTES=262144

# ---- HTTP mode -------------------------------------------------------------
# PORT=8000
# Bearer token for POST /v1/*; set the same value as RUNPOD_POD_TOKEN on the puller.
AIMX_HTTP_TOKEN=

# ---- sidecars --------------------------------------------------------------
# AIMX_VLLM_URL=http://127.0.0.1:8001/v1
# AIMX_VLLM_MODEL=qwen3.6-35b-a3b
AIMX_VLLM_API_KEY=
# AIMX_VLLM_MAX_LEN=32768
# AIMX_VLLM_GPU_UTIL=0.60
# AIMX_LLM_MAX_TOKENS=8192
# AIMX_TIMEOUT_LLM=300
# AIMX_ACESTEP_URL=http://127.0.0.1:8002
# AIMX_ACESTEP_PATH=/release_task

# ---- media input -----------------------------------------------------------
# AIMX_MEDIA_MAX_BYTES=104857600
# AIMX_MEDIA_ALLOW_HTTP=0
